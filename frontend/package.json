{
  "name": "edge-perception-lab-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc",
    "gen:api": "node scripts/api-types.mjs",
    "check:api": "node scripts/api-types.mjs --check",
    "test:unit": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run check:api && npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "@blueprintjs/core": "^6.20.0",
    "@blueprintjs/icons": "^6.14.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
