# Python
__pycache__/
.venv/
*.egg-info/

# Local-only artifacts: fetched model weights, derived frames and exported reports
models/
cache/
exports/

# Frontend
node_modules/
# frontend/dist/ is committed: reviewers run the built app with Python only (scripts/frontend_bundle.py)
frontend/test-results/
frontend/playwright-report/

# Claude Code: share settings and project skills; keep personal config and hook markers local
.claude/*
!.claude/settings.json
!.claude/skills/

# Generated by the e2e tests
frontend/.e2e-dataset/
frontend/.e2e-dataset-benchmark/
frontend/.e2e-cache/
frontend/.e2e-exports/

# Personal dataset download links (registration-gated, may be signed)
/datasets/

# Full-length source footage; only the short cut clips in samples/ are committed
samples/*.webm
